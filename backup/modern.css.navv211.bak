
:root{
    --bg:#0f172a;
    --card:#1e293b;
    --card-hover:#334155;
    --accent:#22c55e;
    --text:#f8fafc;
    --muted:#94a3b8;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:Inter,sans-serif;
}

.app-layout{
    display:flex;
    min-height:100vh;
}

.sidebar{

    width:220px;

    position:fixed;

    top:0;
    left:0;

    transform:translateX(-100%);

    transition:
        transform .18s ease;

    z-index:1000;

    background:#020617;

    height:100vh;

    padding:20px;
}

.sidebar.active{
    transform:translateX(0);
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:14px;
    border-radius:12px;
    margin-bottom:10px;
}

.sidebar a:hover{
    background:#1e293b;
}

#overlay{
    position:fixed;
    inset:0;

    background:rgba(0,0,0,.5);

    opacity:0;
    visibility:hidden;

    transition:.2s;

    z-index:900;
}

#overlay.active{
    opacity:1;
    visibility:visible;
}

.main-content{
    width:100%;
    padding:16px;
}

.burger{
    background:none;
    border:none;
    color:white;
    font-size:28px;
    cursor:pointer;
}

.summary-grid{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-top:20px;
}

.card{
    background:var(--card);

    border-radius:20px;

    padding:24px;

    box-shadow:
        0 10px 30px rgba(0,0,0,.2);

    backdrop-filter:blur(12px);

    border:
        1px solid rgba(
            255,
            255,
            255,
            .05
        );
}

.card:hover{
    background:var(--card-hover);
}

.card-title{
    color:var(--muted);
    margin-bottom:10px;
}

.card-value{
    font-size:2rem;
    font-weight:bold;
}

.chart-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:20px;
}

.chart-card{
    background:var(--card);
    border-radius:20px;
    padding:20px;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:14px;
    text-align:left;
}

tr{
    border-bottom:1px solid #334155;
}


/* V2.1.1 Burger Flash Fix */

.burger{
    display:none;
}

body.logged-in .burger{
    display:block;
}


.income{
    color:#22c55e;
}

.expense{
    color:#ef4444;
}

.savings{
    color:#38bdf8;
}

.quick-form{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(180px,1fr));
    gap:10px;
}

.quick-form input,
.quick-form select,
.quick-form button{

    padding:12px;

    border:none;

    border-radius:12px;
}

.quick-form button{

    background:#22c55e;

    color:white;

    cursor:pointer;
}


/* ============================
   PACKAGE 2.1 MOBILE FIXES
============================ */

.card{
    min-height:120px;
}

.chart-card canvas{
    max-height:250px;
}

@media (max-width:768px){

    .summary-grid{

        grid-template-columns:
            1fr;

        gap:12px;
    }

    .chart-grid{

        grid-template-columns:
            1fr;

        gap:12px;
    }

    .quick-form{

        grid-template-columns:
            1fr;
    }

    .main-content{

        padding:12px;
    }

    .card{

        padding:18px;
    }

    .card-value{

        font-size:1.5rem;
    }

    .sidebar{

        width:220px;
    }

    table{

        display:none;
    }

    h1{

        font-size:1.5rem;
    }

}

/* Small Phones */

@media (max-width:480px){

    .card{

        padding:14px;
    }

    .card-value{

        font-size:1.3rem;
    }

    .burger{

        font-size:24px;
    }

}
