body { font-family: 'Montserrat', sans-serif; margin:0; padding:0; }
.side-menu { width:200px; float:left; background:#2E8B57; color:white; height:100vh; padding:1rem; }
.side-menu ul { list-style:none; padding:0; }
.side-menu ul li { margin:1rem 0; }
.main-content { margin-left:220px; padding:1rem; }
.card { background:#3CB371; color:white; padding:1rem; margin:1rem 0; border-radius:10px; display:inline-block; width:30%; }
.transactions-section table { width:100%; border-collapse:collapse; }
.transactions-section th, td { border:1px solid #ccc; padding:0.5rem; }