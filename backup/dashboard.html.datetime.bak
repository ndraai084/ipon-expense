
{% extends 'base.html' %}

{% block content %}

<h1 style="font-size:2rem;margin-bottom:20px;">
Dashboard
</h1>

<div class="summary-grid">

    <div class="card stat-card">
        <div class="card-title">
            Total Balance
        </div>
        <div class="card-value">
            ₱{{ balance }}
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-title">
            Income
        </div>
        <div class="card-value income">
            ₱{{ total_income }}
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-title">
            Expense
        </div>
        <div class="card-value expense">
            ₱{{ total_expense }}
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-title">
            Savings
        </div>
        <div class="card-value savings">
            ₱{{ balance }}
        </div>
    </div>

</div>

<div class="chart-grid">

    <div class="chart-card">
        <h3>Income vs Expense</h3>
        <canvas id="incomeExpenseChart"></canvas>
    </div>

    <div class="chart-card">
        <h3>Monthly Trends</h3>
        <canvas id="monthlyChart"></canvas>
    </div>

</div>

<div class="card" style="margin-top:20px;">

    <h2 style="margin-bottom:15px;">
        Quick Add Transaction
    </h2>

    <form
        action="/transactions/add"
        method="POST"
        class="quick-form">

        <input
            type="number"
            step="0.01"
            name="amount"
            placeholder="Amount"
            required>

        <select name="type">

            <option value="income">
                Income
            </option>

            <option value="expense">
                Expense
            </option>

        </select>

        <select name="category">

            {% for category in DEFAULT_CATEGORIES %}
            <option value="{{ category }}">
                {{ category }}
            </option>
            {% endfor %}

        </select>

        <input
            type="text"
            name="note"
            placeholder="Note">

        <button type="submit">
            Add Transaction
        </button>

    </form>

</div>

<div class="card" style="margin-top:20px;">

    <h2 style="margin-bottom:15px;">
        Recent Transactions
    </h2>

    <table>

        <thead>

        <tr>
            <th>Date</th>
            <th>Category</th>
            <th>Type</th>
            <th>Amount</th>
        </tr>

        </thead>

        <tbody>

        {% for t in transactions[:5] %}

        <tr>

            <td>{{ t.date }}</td>

            <td>{{ t.category }}</td>

            <td>{{ t.type }}</td>

            <td>₱{{ t.amount }}</td>

        </tr>

        {% endfor %}

        </tbody>

    </table>

</div>

<script>

document.addEventListener(
"DOMContentLoaded",
() => {

    gsap.from(
        ".stat-card",
        {
            opacity:0,
            y:30,
            stagger:.1,
            duration:.6
        }
    );

    const incomeExpenseCtx =
        document.getElementById(
            "incomeExpenseChart"
        );

    if(incomeExpenseCtx){

        new Chart(
            incomeExpenseCtx,
            {
                type:"bar",

                data:{
                    labels:
                        {{ income_expense_chart_data.labels|tojson }},

                    datasets:[
                        {
                            label:"Amount",

                            data:
                                {{ income_expense_chart_data.data|tojson }}
                        }
                    ]
                }
            }
        );

    }

    const monthlyCtx =
        document.getElementById(
            "monthlyChart"
        );

    if(monthlyCtx){

        new Chart(
            monthlyCtx,
            {
                type:"line",

                data:{
                    labels:
                        {{ monthly_chart_data.labels|tojson }},

                    datasets:[
                        {
                            label:"Income",

                            data:
                                {{ monthly_chart_data.income|tojson }}
                        },
                        {
                            label:"Expense",

                            data:
                                {{ monthly_chart_data.expense|tojson }}
                        }
                    ]
                }
            }
        );

    }

});

</script>

{% endblock %}
