{% extends "base.html" %}
{% block content %}
<div class="side-menu">
  <ul>
    <li><a href="#">Analytics</a></li>
    <li><a href="#">Transaction History</a></li>
    <li><a href="{{ url_for('settings') }}">Settings</a></li>
    <li><a href="{{ url_for('logout') }}">Log Out</a></li>
  </ul>
</div>
<div class="main-content">
  <div class="summary-cards">
    <div class="card"><h3>Balance</h3><p>₱{{ balance }}</p></div>
    <div class="card"><h3>Total Income</h3><p>₱{{ total_income }}</p></div>
    <div class="card"><h3>Total Expense</h3><p>₱{{ total_expense }}</p></div>
  </div>

  <div class="transaction-form">
    <h3>Add Transaction</h3>
    <form action="{{ url_for('add_trans') }}" method="POST">
      <input type="number" step="0.01" name="amount" placeholder="Amount" required>
      <select name="type">
        <option value="income">Income</option>
        <option value="expense">Expense</option>
      </select>
      <select name="category">
        {% for cat in DEFAULT_CATEGORIES %}
        <option value="{{ cat }}">{{ cat }}</option>
        {% endfor %}
      </select>
      <input type="text" name="note" placeholder="Note">
      <button type="submit">Add</button>
    </form>
  </div>

  <div class="transactions-section">
    <h3>Recent Transactions</h3>
    <table>
      <thead><tr><th>Amount</th><th>Type</th><th>Category</th><th>Note</th><th>Actions</th></tr></thead>
      <tbody>
      {% for t in transactions %}
        <tr>
          <td>{{ t.amount }}</td>
          <td>{{ t.type }}</td>
          <td>{{ t.category }}</td>
          <td>{{ t.note }}</td>
          <td>
            <form action="{{ url_for('edit_trans', trans_id=t.id) }}" method="POST" style="display:inline;">
              <input type="hidden" name="amount" value="{{ t.amount }}">
              <input type="hidden" name="type" value="{{ t.type }}">
              <input type="hidden" name="category" value="{{ t.category }}">
              <input type="hidden" name="note" value="{{ t.note }}">
              <button type="submit">Edit</button>
            </form>
            <a href="{{ url_for('delete_trans', trans_id=t.id) }}">Delete</a>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="charts-section">
    <canvas id="categoryChart"></canvas>
    <canvas id="incomeExpenseChart"></canvas>
    <canvas id="monthlyChart"></canvas>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Example Chart.js integration with Flask JSON data
</script>
{% endblock %}