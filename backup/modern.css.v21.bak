:root{
    --bg:#0f172a;
    --card:#1e293b;
    --card-hover:#334155;
    --accent:#22c55e;
    --text:#f8fafc;
    --muted:#94a3b8;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:Inter,sans-serif;
}

.app-layout{
    display:flex;
    min-height:100vh;
}

.sidebar{
    width:260px;
    background:#020617;
    position:fixed;
    left:-260px;
    top:0;
    height:100%;
    z-index:1000;
    transition:.3s;
    padding:20px;
}

.sidebar.active{
    left:0;
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:14px;
    border-radius:12px;
    margin-bottom:10px;
}

.sidebar a:hover{
    background:#1e293b;
}

.main-content{
    width:100%;
    padding:30px;
}

.burger{
    background:none;
    border:none;
    color:white;
    font-size:28px;
    cursor:pointer;
}

.summary-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-top:20px;
}

.card{
    background:var(--card);
    border-radius:20px;
    padding:24px;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
}

.card:hover{
    background:var(--card-hover);
}

.card-title{
    color:var(--muted);
    margin-bottom:10px;
}

.card-value{
    font-size:2rem;
    font-weight:bold;
}

.chart-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:20px;
}

.chart-card{
    background:var(--card);
    border-radius:20px;
    padding:20px;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:14px;
    text-align:left;
}

tr{
    border-bottom:1px solid #334155;
}